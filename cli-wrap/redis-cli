#!/usr/bin/env bash
#==================================================
# Redis CLI 封装 - 隐藏连接参数，直接使用
# 用法: redis-cli [redis-cli 的其他参数和命令]
# 示例: redis-cli GET foo
#       redis-cli --scan --pattern 'user:*'
#==================================================

# ----- 从 .env 加载配置 -----
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [ -f "$SCRIPT_DIR/../.env" ]; then
    source "$SCRIPT_DIR/../.env"
fi

HOST="192.168.1.30"
PORT="6379"
DB="5"
PASS="Wasu3.14"
# ----------------------------------------

# 如果设定了密码，则通过环境变量传递（不会暴露在进程列表中）
if [ -n "$PASS" ]; then
    export REDISCLI_AUTH="$PASS"
fi

# 屏蔽密码警告（如果有密码但未用 -a 传参会提示，这里关闭）
REDISCLI_NOAUTH_WARNING=true

# 调用真正的 redis-cli，并转发所有用户参数
# 原有的redis-cli 重命名为 redc, 本脚本软连接在 /usr/local/sbin/redis-cli, 确保可以全局执行并替代原有的redis-cli
exec redc -h "$HOST" -p "$PORT" -n "$DB" "$@"